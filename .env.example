APP_NAME=Iran Stock Intelligence
APP_ENV=development
DATABASE_URL=postgresql+psycopg://isi:isi_password@db:5432/iran_stock_intelligence
API_HOST=0.0.0.0
API_PORT=8000
CODAL_BASE_URL=https://search.codal.ir
TSETMC_BASE_URL=https://cdn.tsetmc.com/api
HOST_API_PORT=8001
RAW_DATA_DIR=/app/data/raw
CODAL_SYMBOLS=ساروم
CODAL_POLL_INTERVAL_SECONDS=3600
CODAL_INCREMENTAL_PAGES=3
CODAL_PAGE_SIZE=100

# Admin authentication - replace every value before running
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
ADMIN_SESSION_SECRET=CHANGE_TO_A_RANDOM_SECRET_AT_LEAST_32_BYTES
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_COOKIE_SECURE=false
